[Unit]
Description=AI Trading Terminal (paper mode scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/opt/trading-terminal
EnvironmentFile=/opt/trading-terminal/.env
# Disable Python stdout/stderr buffering so logs appear in journald immediately
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/trading-terminal/.venv/bin/tt schedule --universe nifty500
Restart=always
RestartSec=15
# Send stdout+stderr to journald so `journalctl -u trading-bot.service -f` shows everything.
# (Previous file-append target made debugging painful — file-based logs are still
# easy to re-add later with `StandardOutput=append:/var/log/trading-bot/out.log`.)
StandardOutput=journal
StandardError=journal

# Resource hygiene
MemoryMax=1G
CPUQuota=80%

# Security hygiene
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/trading-terminal /var/log/trading-bot
# read-only (not "true") so service can READ uv binary from /home/trader/.local/bin/
# but can't write to home dirs
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
